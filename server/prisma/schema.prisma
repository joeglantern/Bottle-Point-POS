// Bottle Point data model.
// Money is always stored as integer cents (KSh x 100). Never floats.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CASHIER
  MANAGER
  OWNER
}

enum SaleStatus {
  OPEN
  SAVED
  PAID
  CANCELLED
  REFUNDED
}

enum PayMethod {
  CASH
  MPESA
}

// How we know an M-Pesa payment is real.
//   CASH: not applicable
//   STK_CONFIRMED: Safaricom callback (or STK query) confirmed it
//   MANUAL_UNVERIFIED: cashier typed the code from the customer's SMS (fallback)
//   MANUAL_VERIFIED / MANUAL_REJECTED: a manager checked the typed code
enum PaymentVerification {
  CASH
  STK_CONFIRMED
  MANUAL_UNVERIFIED
  MANUAL_VERIFIED
  MANUAL_REJECTED
}

enum MpesaStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  TIMEOUT
}

enum ApprovalKind {
  CANCEL
  REFUND
  DISCOUNT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StockReason {
  SALE
  REFUND
  RECEIVE
  ADJUST
}

// ---------- Business and branches ----------

model Business {
  id        String   @id @default(cuid())
  name      String
  // the client's own address: <slug>.<TENANT_BASE_DOMAIN>, for example nyrolix
  slug      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // shown on receipts and invoices, edited by the owner in Admin
  legalName     String?
  email         String?
  phone         String?
  address       String?
  kraPin        String?
  receiptFooter String?
  // VAT in basis points: 1600 = 16%
  vatRateBps    Int     @default(1600)
  currency      String  @default("KES")

  branches     Branch[]
  users        User[]
  products     Product[]
  customers    Customer[]
  mpesaConfig  MpesaConfig?
  subscription Subscription?
  invoices     Invoice[]
  notes        TenantNote[]
}

// ---------- Per business M-Pesa (each shop has its own Paybill or Till) ----------

enum MpesaMode {
  MOCK
  SANDBOX
  PRODUCTION
}

model MpesaConfig {
  businessId        String    @id
  enabled           Boolean   @default(false)
  mode              MpesaMode @default(MOCK)
  shortcode         String?
  // Buy Goods uses the till number as PartyB; Paybill uses the shortcode
  partyB            String?
  transactionType   String    @default("CustomerPayBillOnline")
  // secrets are stored encrypted (see lib/secrets.ts), never returned by the API
  consumerKeyEnc    String?
  consumerSecretEnc String?
  passkeyEnc        String?
  updatedById       String?
  updatedAt         DateTime  @default(now()) @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ---------- Platform (the company running Bottle Point as a service) ----------

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
  BILLING
}

enum PricingModel {
  FLAT
  PER_BRANCH
  PERCENT_OF_SALES
  ONE_TIME
}

enum BillingInterval {
  MONTH
  YEAR
  ONCE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
}

enum InvoicePayMethod {
  MPESA
  BANK
  CARD
  CASH
  OTHER
}

model Plan {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  description    String?
  model          PricingModel
  interval       BillingInterval @default(MONTH)
  // FLAT and ONE_TIME: the price. PER_BRANCH: the base fee.
  priceCents     Int             @default(0)
  // PER_BRANCH: added for each active branch
  perBranchCents Int             @default(0)
  // PERCENT_OF_SALES: share of paid sales in basis points (150 = 1.5%)
  percentBps     Int             @default(0)
  // PERCENT_OF_SALES: floor per period
  minimumCents   Int             @default(0)
  trialDays      Int             @default(14)
  // null means unlimited
  maxBranches    Int?
  maxStaff       Int?
  maxProducts    Int?
  // feature switches, for example { "mpesaStk": true, "exports": true }
  features       Json            @default("{}")
  active         Boolean         @default(true)
  // public plans can be offered to anyone; private ones are negotiated deals
  public         Boolean         @default(true)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                 String             @id @default(cuid())
  businessId         String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  cancelledAt        DateTime?
  // negotiated deals
  discountBps        Int                @default(0)
  customPriceCents   Int?
  suspendedReason    String?
  suspendedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([status])
}

model Invoice {
  id             String        @id @default(cuid())
  // human readable, for example INV-2026-000123
  number         String        @unique
  businessId     String
  subscriptionId String?
  periodStart    DateTime
  periodEnd      DateTime
  // [{ description, quantity, unitCents, amountCents }]
  lines          Json
  subtotalCents  Int
  taxCents       Int
  totalCents     Int
  paidCents      Int           @default(0)
  status         InvoiceStatus @default(OPEN)
  issuedAt       DateTime      @default(now())
  dueAt          DateTime
  paidAt         DateTime?
  voidedAt       DateTime?
  notes          String?
  createdAt      DateTime      @default(now())

  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription Subscription?    @relation(fields: [subscriptionId], references: [id])
  payments     InvoicePayment[]

  // one invoice per subscription period, so a billing run can be repeated safely
  @@unique([subscriptionId, periodStart])
  @@index([businessId, issuedAt])
  @@index([status, dueAt])
}

model InvoicePayment {
  id           String           @id @default(cuid())
  invoiceId    String
  amountCents  Int
  method       InvoicePayMethod
  reference    String?
  receivedAt   DateTime
  recordedById String
  createdAt    DateTime         @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// Internal notes the platform team keeps about a client. Never shown to the client.
model TenantNote {
  id         String   @id @default(cuid())
  businessId String
  authorId   String
  body       String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

// Invoice numbers per year, incremented atomically.
model InvoiceCounter {
  year Int @id
  last Int @default(0)
}

model Branch {
  id         String   @id @default(cuid())
  businessId String
  name       String
  // next human readable sale number for this branch, incremented atomically
  nextSaleNo Int      @default(1001)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  business     Business       @relation(fields: [businessId], references: [id])
  users        UserBranch[]
  sales        Sale[]
  shifts       Shift[]
  stock        Stock[]
  movements    StockMovement[]
  mpesaRequest MpesaRequest[]

  @@unique([businessId, name])
}

// ---------- Users (shared with Better Auth) ----------

model User {
  id              String    @id
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  username        String?   @unique
  displayUsername String?

  // Bottle Point fields
  businessId    String?
  // set only for staff of the company running the platform (console users)
  platformRole  PlatformRole?
  role          Role      @default(CASHIER)
  active        Boolean   @default(true)
  failedPins    Int       @default(0)
  lockedUntil   DateTime?

  business  Business?    @relation(fields: [businessId], references: [id])
  branches  UserBranch[]
  sessions  Session[]
  accounts  Account[]

  @@map("user")
}

model UserBranch {
  userId   String
  branchId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------- Catalog and stock ----------

model Product {
  id         String   @id @default(cuid())
  businessId String
  name       String
  sizeMl     Int?
  category   String
  barcode    String?
  priceCents Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business  Business        @relation(fields: [businessId], references: [id])
  stock     Stock[]
  lines     SaleLine[]
  movements StockMovement[]

  @@unique([businessId, barcode])
  @@index([businessId, category])
}

model Stock {
  branchId  String
  productId String
  qty       Int     @default(0)
  // alert when qty drops below this
  reorderAt Int     @default(10)

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@id([branchId, productId])
}

model StockMovement {
  id        String      @id @default(cuid())
  branchId  String
  productId String
  delta     Int
  reason    StockReason
  saleId    String?
  userId    String
  note      String?
  createdAt DateTime    @default(now())

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([branchId, productId, createdAt])
}

// ---------- Customers ----------

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  sales    Sale[]

  @@unique([businessId, phone])
}

// ---------- Shifts ----------

model Shift {
  id                String    @id @default(cuid())
  branchId          String
  userId            String
  openedAt          DateTime  @default(now())
  openingFloatCents Int
  closedAt          DateTime?
  // filled when the shift is closed
  expectedCashCents Int?
  countedCashCents  Int?
  varianceCents     Int?
  closeNote         String?

  branch   Branch    @relation(fields: [branchId], references: [id])
  payments Payment[]
  refunds  Refund[]

  @@index([branchId, openedAt])
  @@index([userId, closedAt])
}

// ---------- Sales ----------

model Sale {
  id            String     @id @default(cuid())
  number        Int
  branchId      String
  createdById   String
  label         String?
  customerId    String?
  status        SaleStatus @default(OPEN)
  subtotalCents Int        @default(0)
  discountCents Int        @default(0)
  totalCents    Int        @default(0)
  paidById      String?
  paidAt        DateTime?
  cancelledAt   DateTime?
  refundedAt    DateTime?
  // optimistic concurrency: bumped on every change to lines or status
  version       Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  branch        Branch         @relation(fields: [branchId], references: [id])
  customer      Customer?      @relation(fields: [customerId], references: [id])
  lines         SaleLine[]
  payments      Payment[]
  approvals     Approval[]
  mpesaRequests MpesaRequest[]
  refunds       Refund[]

  @@unique([branchId, number])
  @@index([branchId, status, createdAt])
}

model SaleLine {
  id        String @id @default(cuid())
  saleId    String
  productId String
  // snapshots, so later price or name changes never rewrite history
  name      String
  unitCents Int
  qty       Int

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([saleId, productId])
}

model Payment {
  id             String              @id @default(cuid())
  saleId         String
  method         PayMethod
  amountCents    Int
  // for cash: what the customer handed over (change = tendered - amount)
  tenderedCents  Int?
  // M-Pesa receipt code. One code can only ever belong to one payment.
  mpesaRef       String?             @unique
  phone          String?
  verification   PaymentVerification
  mpesaRequestId String?             @unique
  receivedById   String
  shiftId        String?
  verifiedById   String?
  verifiedAt     DateTime?
  createdAt      DateTime            @default(now())

  sale         Sale          @relation(fields: [saleId], references: [id])
  shift        Shift?        @relation(fields: [shiftId], references: [id])
  mpesaRequest MpesaRequest? @relation(fields: [mpesaRequestId], references: [id])

  @@index([saleId])
  @@index([shiftId])
}

// One STK push sent to a customer's phone for (part of) a sale.
model MpesaRequest {
  id                String      @id @default(cuid())
  saleId            String
  branchId          String
  phone             String
  amountCents       Int
  merchantRequestId String?
  checkoutRequestId String?     @unique
  status            MpesaStatus @default(PENDING)
  resultCode        Int?
  resultDesc        String?
  receipt           String?     @unique
  requestedById     String
  shiftId           String?
  rawCallback       Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  sale    Sale     @relation(fields: [saleId], references: [id])
  branch  Branch   @relation(fields: [branchId], references: [id])
  payment Payment?

  @@index([saleId])
  @@index([branchId, status])
}

// ---------- Approvals and refunds ----------

model Approval {
  id            String         @id @default(cuid())
  saleId        String
  kind          ApprovalKind
  status        ApprovalStatus @default(PENDING)
  reason        String
  // DISCOUNT: amount requested. REFUND: amount to refund.
  amountCents   Int?
  // REFUND: how the money goes back
  refundMethod  PayMethod?
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime       @default(now())

  sale Sale @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@index([status, createdAt])
}

model Refund {
  id           String    @id @default(cuid())
  saleId       String
  approvalId   String    @unique
  amountCents  Int
  method       PayMethod
  // cash refunds leave the till of this shift
  shiftId      String?
  paidOutById  String
  createdAt    DateTime  @default(now())

  sale  Sale   @relation(fields: [saleId], references: [id])
  shift Shift? @relation(fields: [shiftId], references: [id])
}

// ---------- Audit ----------

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  userId     String?
  businessId String?
  branchId   String?
  action     String
  entity     String
  entityId   String?
  data       Json?

  @@index([branchId, at])
  @@index([entity, entityId])
}
