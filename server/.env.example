NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://bottlepoint:bottlepoint@127.0.0.1:5544/bottlepoint
# Long random string: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
# Comma separated origins allowed to call the API with cookies
TRUSTED_ORIGINS=http://localhost:5173

# M-Pesa (Daraja). MPESA_MODE: mock | sandbox | production
MPESA_MODE=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Public https URL Safaricom calls back. The token makes the URL unguessable.
MPESA_CALLBACK_URL=https://example.com/api/mpesa/callback
MPESA_CALLBACK_TOKEN=change-me-random-token
